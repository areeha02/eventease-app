<%- include('partials/header') %>
<div class="wrap">
  <div class="confirm">
    <div class="check"><svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4.5 4.5L19 7"/></svg></div>
    <h1 style="font-size:28px">Request submitted &#9825;</h1>
    <p class="muted" style="margin-top:6px"><%= bk.listing_name %> will review your request and respond. This is not a confirmed reservation yet.</p>
    <div class="summary">
      <div class="r"><span>Reference</span><b><%= bk.ref %></b></div>
      <div class="r"><span>Venue / service</span><b><%= bk.listing_name %></b></div>
      <div class="r"><span>Event</span><b><%= bk.event_type || ',' %> &middot; <%= bk.event_date %></b></div>
      <div class="r"><span>Guests &middot; Time</span><b><%= bk.guests || ',' %> &middot; <%= bk.time_pref || ',' %></b></div>
      <div class="r"><span>Status</span><span class="badge <%= bk.status %>"><%= bk.status %></span></div>
    </div>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
      <a class="btn btn-primary" href="/dashboard/bookings">View my bookings</a>
      <a class="btn btn-outline" href="/services">Browse more</a>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
