<%- include('partials/header') %>
<section class="sec"><div class="wrap">
  <div class="sec-head">
    <h2>Plans &amp; membership</h2>
    <svg class="tu" viewBox="0 0 118 11" fill="none"><path d="M3 7 Q18 1 33 7 T63 7 T93 7 T115 7" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
    <p>Browsing vendors and sending booking requests is always free. Upgrade for extra perks.</p>
  </div>
  <div class="plans-grid">
    <div class="plan">
      <h3>Free</h3>
      <div class="price">PKR 0<span> / forever</span></div>
      <ul>
        <li>Browse all local vendors</li>
        <li>Search &amp; filters</li>
        <li>Send booking requests</li>
        <li>Track requests in your dashboard</li>
        <li class="off">Saved favourites</li>
        <li class="off">Priority support</li>
      </ul>
      <a class="btn btn-outline btn-block" href="/signup">Get started</a>
    </div>
    <div class="plan feat">
      <span class="badge-best">Most popular</span>
      <h3>Premium</h3>
      <div class="price">PKR 499<span> / month</span></div>
      <ul>
        <li>Everything in Free</li>
        <li>Saved favourites</li>
        <li>Priority booking requests</li>
        <li>Priority support</li>
        <li>Early access to deals</li>
        <li class="off">Dedicated planner</li>
      </ul>
      <a class="btn btn-primary btn-block" href="/signup">Start free trial</a>
    </div>
    <div class="plan">
      <h3>Event Pro</h3>
      <div class="price">PKR 1,499<span> / event</span></div>
      <ul>
        <li>Everything in Premium</li>
        <li>Dedicated event planner</li>
        <li>Vendor coordination</li>
        <li>On-day support</li>
        <li>Custom packages</li>
        <li>Priority everything</li>
      </ul>
      <a class="btn btn-outline btn-block" href="/contact">Contact us</a>
    </div>
  </div>
  <p class="hint" style="margin-top:22px">Prices in PKR, cancel anytime. Secure online payments are coming soon.</p>
</div></section>
<%- include('partials/footer') %>
