      <div class="gridp">
        <span style="background-image:url('/img/wedding-1.jpg')"></span>
        <span style="background-image:url('/img/photography-1.jpg')"></span>
        <span style="background-image:url('/img/catering-1.jpg')"></span>
        <span style="background-image:url('/img/decor-1.jpg')"></span>
        <span style="background-image:url('/img/bridal-1.jpg')"></span>
        <span style="background-image:url('/img/groom-1.jpg')"></span>
        <span style="background-image:url('/img/corporate-1.jpg')"></span>
        <span style="background-image:url('/img/seminar-1.jpg')"></span>
        <span style="background-image:url('/img/wedding-2.jpg')"></span>
      </div>
    </div></div>
    <div style="text-align:center">
      <div class="qr"><svg viewBox="0 0 100 100" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" fill="#2A1320"><rect x="6" y="6" width="28" height="28"/><rect x="10" y="10" width="20" height="20" fill="#fff"/><rect x="14" y="14" width="12" height="12"/><rect x="66" y="6" width="28" height="28"/><rect x="70" y="10" width="20" height="20" fill="#fff"/><rect x="74" y="14" width="12" height="12"/><rect x="6" y="66" width="28" height="28"/><rect x="10" y="70" width="20" height="20" fill="#fff"/><rect x="14" y="74" width="12" height="12"/><rect x="42" y="8" width="5" height="5"/><rect x="50" y="8" width="5" height="5"/><rect x="44" y="16" width="5" height="5"/><rect x="54" y="18" width="5" height="5"/><rect x="40" y="26" width="5" height="5"/><rect x="48" y="30" width="5" height="5"/><rect x="8" y="42" width="5" height="5"/><rect x="18" y="44" width="5" height="5"/><rect x="26" y="40" width="5" height="5"/><rect x="40" y="42" width="5" height="5"/><rect x="48" y="46" width="5" height="5"/><rect x="58" y="42" width="5" height="5"/><rect x="66" y="46" width="5" height="5"/><rect x="74" y="42" width="5" height="5"/><rect x="84" y="44" width="5" height="5"/><rect x="42" y="54" width="5" height="5"/><rect x="52" y="56" width="5" height="5"/><rect x="62" y="54" width="5" height="5"/><rect x="72" y="58" width="5" height="5"/><rect x="82" y="54" width="5" height="5"/><rect x="44" y="66" width="5" height="5"/><rect x="54" y="70" width="5" height="5"/><rect x="64" y="66" width="5" height="5"/><rect x="74" y="72" width="5" height="5"/><rect x="84" y="66" width="5" height="5"/><rect x="46" y="80" width="5" height="5"/><rect x="58" y="84" width="5" height="5"/><rect x="68" y="80" width="5" height="5"/><rect x="80" y="82" width="5" height="5"/></svg></div>
      <div class="muted" style="font-size:11.5px;margin-top:6px">Scan to get the app</div>
    </div>
  </div>
</div></section>

<%- include('partials/footer') %>
