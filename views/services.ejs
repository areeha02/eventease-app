<%- include('partials/header') %>
<section class="sec"><div class="wrap">
  <div style="margin-bottom:18px">
    <% if (cat) { %><span class="eyebrow"><%= cat.short %></span><% } %>
    <h1 style="font-size:clamp(26px,4vw,34px);margin-top:4px"><%= heading %></h1>
    <% if (cat) { %><p class="muted" style="margin-top:4px"><%= cat.blurb %></p><% } %>
  </div>

  <form class="filters" action="/services" method="get">
    <div class="fld wide"><label>Search</label><input name="q" value="<%= f.q || '' %>" placeholder="Venue or service name"></div>
    <div class="fld"><label>City</label><select name="city"><option value="">All</option><% cities.forEach(function(c){ %><option value="<%= c %>" <%= f.city === c ? 'selected' : '' %>><%= c %></option><% }) %></select></div>
    <div class="fld"><label>Category</label><select name="cat"><option value="">All</option><% categories.forEach(function(c){ %><option value="<%= c.key %>" <%= f.cat === c.key ? 'selected' : '' %>><%= c.short %></option><% }) %></select></div>
    <div class="fld"><label>Min PKR</label><input name="min" type="number" value="<%= f.min || '' %>" placeholder="0"></div>
    <div class="fld"><label>Max PKR</label><input name="max" type="number" value="<%= f.max || '' %>" placeholder="any"></div>
    <div class="fld"><label>Min guests</label><input name="cap" type="number" value="<%= f.cap || '' %>" placeholder="any"></div>
    <div class="fld"><label>Sort</label><select name="sort">
      <option value="">Best match</option>
      <option value="price_asc" <%= f.sort === 'price_asc' ? 'selected' : '' %>>Price: low to high</option>
      <option value="price_desc" <%= f.sort === 'price_desc' ? 'selected' : '' %>>Price: high to low</option>
    </select></div>
    <div class="fld"><label>&nbsp;</label><button class="btn btn-primary btn-block" type="submit">Apply</button></div>
  </form>

  <div class="count"><%= listings.length %> result<%= listings.length === 1 ? '' : 's' %> found</div>
  <% if (listings.length === 0) { %>
    <div class="empty">No matches found. Try removing some filters.</div>
  <% } else { %>
    <div class="grid"><% listings.forEach(function(l){ %><%- include('partials/card', { l: l }) %><% }) %></div>
  <% } %>
</div></section>
<%- include('partials/footer') %>
