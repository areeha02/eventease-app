<%- include('partials/header') %>
<div class="wrap"><div class="dash">
  <aside class="dside">
    <div class="duser"><span class="av"><%= user.name.charAt(0) %></span><div><b><%= user.name %></b><span>Customer</span></div></div>
    <nav class="dnav">
      <a class="on" href="/dashboard">Overview</a>
      <a href="/dashboard/bookings">My bookings</a>
      <a href="/services">Browse services</a>
      <form class="inline" method="post" action="/logout"><button type="submit" style="width:100%;text-align:left;background:none;border:none;font:inherit;cursor:pointer;padding:10px 12px;border-radius:10px;font-weight:600;color:var(--muted)">Logout</button></form>
    </nav>
  </aside>
  <div>
    <div class="dhead"><div><h1>Welcome back, <%= user.name.split(' ')[0] %> &#9825;</h1><p class="muted">Here's an overview of your event bookings.</p></div><a class="btn btn-primary" href="/services">+ New booking</a></div>
    <div class="stats">
      <div class="stat"><b><%= stats.total %></b><span>Total requests</span></div>
      <div class="stat"><b><%= stats.pending %></b><span>Pending</span></div>
      <div class="stat"><b><%= stats.approved %></b><span>Approved</span></div>
    </div>
    <h3 style="font-size:17px;margin-bottom:12px">Recent requests</h3>
    <% if (recent.length === 0) { %>
      <div class="empty">No bookings yet. <a href="/services" style="color:var(--primary);font-weight:600">Browse services</a> to get started.</div>
    <% } else { %>
      <div class="tablewrap"><table class="tbl"><thead><tr><th>Ref</th><th>Venue / service</th><th>Date</th><th>Guests</th><th>Status</th></tr></thead><tbody>
        <% recent.forEach(function(b){ %><tr><td><%= b.ref %></td><td><a href="/listing/<%= b.listing_slug %>" style="color:var(--primary);font-weight:600"><%= b.listing_name %></a></td><td><%= b.event_date %></td><td><%= b.guests || ',' %></td><td><span class="badge <%= b.status %>"><%= b.status %></span></td></tr><% }) %>
      </tbody></table></div>
    <% } %>
  </div>
</div></div>
<%- include('partials/footer') %>
