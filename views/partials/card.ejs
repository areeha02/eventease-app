<a class="card" href="/listing/<%= l.slug %>">
  <div class="ph" style="--h:<%= l.hue %>;background-image:url('<%= imageFor(l) %>')"><span class="tag"><%= CAT[l.category].short %></span></div>
  <div class="card-body">
    <div class="card-top">
      <h3><%= l.name %></h3>
    </div>
    <div class="loc"><%= l.area ? l.area + ', ' : '' %><%= l.city %></div>
    <div class="meta">
      <% if (CAT[l.category].capacity && l.capacity) { %><span class="mtag">Up to <%= l.capacity %> guests</span><% } %>
      <span class="mtag"><%= CAT[l.category].short %></span>
    </div>
    <div class="card-foot">
      <div class="price"><%= priceLabel(l) %></div>
      <span class="pill-sm">View details &rarr;</span>
    </div>
  </div>
</a>
